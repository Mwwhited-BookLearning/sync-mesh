<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!--
      Feature files are linked in from docs/bdd/features/ (outside this
      project's directory tree) — code-behind must go to obj/, not next to
      the linked source, or it pollutes docs/ with generated .cs files.
    -->
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Reqnroll.MsTest" Version="3.3.4" />
    <PackageReference Include="MSTest" Version="4.3.2" />
    <PackageReference Include="Testcontainers" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SyncMesh.Contracts\SyncMesh.Contracts.csproj" />
    <ProjectReference Include="..\..\src\SyncMesh.EventStore\SyncMesh.EventStore.csproj" />
    <ProjectReference Include="..\..\src\SyncMesh.EventStore.Migrations.Sqlite\SyncMesh.EventStore.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\SyncMesh.Daemon\SyncMesh.Daemon.csproj" />
    <ProjectReference Include="..\..\src\SyncMesh.ServerHost\SyncMesh.ServerHost.csproj" />
    <ProjectReference Include="..\..\tools\FeatureDocExtractor\FeatureDocExtractor.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Feature files are GENERATED from docs/bdd/design/*.md (the actual
    source of truth — per CLAUDE.md and ARCHITECTURE.md → "Feature-doc
    extraction tooling") via tools/FeatureDocExtractor, into
    docs/bdd/features/*.feature, which is gitignored build output — never
    hand-edit it.

    Generation MUST happen during the implicit Restore pass (BeforeTargets
    ="Restore"), not a Target hooked into the normal Build pass. Reqnroll
    computes required per-item metadata (CodeBehindFile, MessagesFile,
    NormalizedLogicalName, etc.) on ReqnrollFeatureFile items via ItemGroup
    transforms that run once, at project-EVALUATION time, in its own
    imported .targets file (see reqnroll.tools.msbuild.generation's
    Reqnroll.Tools.MsBuild.Generation.targets) — not inside any Target.
    Items added to that ItemGroup from inside a Build-pass Target (tried
    first, see git history) are visible to later targets but never receive
    that metadata, so Reqnroll's codegen silently produces nothing useful
    and the test assembly ends up with zero discoverable tests. "dotnet
    build"/"dotnet test" always run an implicit Restore as a distinct,
    earlier MSBuild pass first — generating the .feature files during that
    pass means they already exist on disk by the time the real Build pass
    evaluates the static glob below, so Reqnroll's own evaluation-time
    metadata transforms see them exactly as they would a checked-in file.
  -->
  <Target Name="ExtractFeatureDocs" BeforeTargets="Restore">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\tools\FeatureDocExtractor\FeatureDocExtractor.csproj&quot; -- &quot;$(MSBuildThisFileDirectory)..\..\docs\bdd\design&quot; &quot;$(MSBuildThisFileDirectory)..\..\docs\bdd\features&quot;" />
  </Target>

  <ItemGroup>
    <ReqnrollFeatureFile Include="..\..\docs\bdd\features\*.feature" Link="Features\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
